{
  "name": "reactboy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @reactboy/web dev",
    "build": "pnpm --filter @reactboy/web build",
    "preview": "pnpm --filter @reactboy/web preview",
    "test": "pnpm -r test",
    "test:roms": "pnpm --filter @reactboy/core test:roms",
    "test:e2e": "pnpm --filter @reactboy/web test:e2e",
    "fetch-roms": "node scripts/fetch-test-roms.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
